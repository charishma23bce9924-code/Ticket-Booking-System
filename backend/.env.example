# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite by default - zero config)
DATABASE_URL="file:./dev.db"
# For Postgres in production, use something like:
# DATABASE_URL="postgresql://user:password@host:5432/ticketdb"

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Seat hold TTL (minutes)
SEAT_HOLD_TTL_MINUTES=10
# Waitlist offer TTL (minutes)
WAITLIST_OFFER_TTL_MINUTES=15

# Email (Gmail SMTP) - use an App Password, NOT your normal Gmail password:
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM="Ticket Booking <your_gmail_address@gmail.com>"
